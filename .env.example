# Variáveis do BoxBim no servidor (Easypanel › App › Environment). Copie as que usar.
PORTA=3000
BOXBIM_DATA=/data
# o Easypanel entrega por HTTPS: cookie de sessão só por HTTPS
BOXBIM_HTTPS=1
# atrás do proxy do Easypanel (IP real do cliente para o limite de tentativas)
BOXBIM_PROXY=1
# servidor na nuvem: desliga Revit/Unreal/Blender e acesso a arquivos do computador
BOXBIM_REMOTO=1
# opcional: exige este código para criar conta (a 1ª conta, do administrador, não precisa)
BOXBIM_CODIGO_CADASTRO=troque-este-codigo
