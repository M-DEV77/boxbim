{
  "format": "boxbim-objeto",
  "version": 1,
  "revision": 1,
  "author": "BoxBim",
  "created": "2026-10-21",
  "id": "cadeira",
  "name": "Cadeira",
  "category": "IfcFurniture",
  "description": "Cadeira com assento, pernas traseiras prolongadas e encosto em ripas.",
  "parameters": [
    {
      "name": "largura",
      "label": "Largura",
      "type": "comprimento",
      "default": 0.45,
      "min": 0.35,
      "max": 0.7,
      "group": "Dimensões"
    },
    {
      "name": "profundidade",
      "label": "Profundidade",
      "type": "comprimento",
      "default": 0.48,
      "min": 0.35,
      "max": 0.7,
      "group": "Dimensões"
    },
    {
      "name": "alturaAssento",
      "label": "Altura do assento",
      "type": "comprimento",
      "default": 0.45,
      "min": 0.3,
      "max": 0.8,
      "group": "Dimensões"
    },
    {
      "name": "alturaEncosto",
      "label": "Altura total",
      "type": "comprimento",
      "default": 0.9,
      "min": 0.6,
      "max": 1.3,
      "group": "Dimensões"
    },
    {
      "name": "espessura",
      "label": "Espessura",
      "type": "comprimento",
      "default": 0.03,
      "min": 0.015,
      "max": 0.06,
      "group": "Construção"
    },
    {
      "name": "perna",
      "label": "Seção da perna",
      "type": "comprimento",
      "default": 0.035,
      "min": 0.02,
      "max": 0.06,
      "group": "Construção"
    },
    {
      "name": "ripas",
      "label": "Ripas do encosto",
      "type": "inteiro",
      "default": 3,
      "min": 1,
      "max": 6,
      "group": "Construção"
    },
    {
      "name": "material",
      "label": "Material",
      "type": "material",
      "default": "Madeira",
      "group": "Materiais"
    }
  ],
  "script": "// Cadeira: o encosto fica no lado +Y\nconst e = p.espessura, s = p.perna, hs = p.alturaAssento - e;\ng.box(p.largura, p.profundidade, e, { z: hs, material: p.material, name: 'Assento' });\nconst dx = p.largura / 2 - s / 2, dy = p.profundidade / 2 - s / 2;\nfor (const [sx, sy] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) {\n  // as pernas de trás sobem até o topo do encosto\n  g.box(s, s, sy > 0 ? p.alturaEncosto : hs, { x: sx * dx, y: sy * dy, material: p.material, name: 'Perna' });\n}\nconst hEnc = p.alturaEncosto - p.alturaAssento;\nfor (let i = 0; i < p.ripas; i++) {\n  const z = p.alturaAssento + hEnc * (0.35 + 0.55 * i / Math.max(1, p.ripas - 1)) - 0.03;\n  g.box(p.largura - 2 * s, e, 0.06, { y: dy, z, material: p.material, name: 'Ripa do encosto' });\n}\n"
}