{
  "format": "boxbim-objeto",
  "version": 1,
  "revision": 1,
  "author": "BoxBim",
  "created": "2026-10-23",
  "id": "telhado",
  "name": "Telhado",
  "category": "IfcRoof",
  "sistema": "telhado",
  "description": "Telhado criado pela ferramenta Telhado: perfil desenhado num eixo de trabalho, extrudado na normal; camadas do tipo de telhado.",
  "parameters": [
    {
      "name": "comprimento",
      "label": "Comprimento (extrusão)",
      "type": "comprimento",
      "default": 6,
      "group": "Dimensões",
      "min": 0.1,
      "max": 500
    }
  ],
  "script": "// Objeto de SISTEMA: usado pela ferramenta Telhado (Modelar).\n// O BoxBim preenche, em cada telhado do modelo:\n//   p.faixas       seção de cada camada no plano do perfil [[[u, v], …], …] (a 1ª logo abaixo da linha desenhada)\n//   p.camadas      [{ nome, material, espessura, funcao }] do tipo de telhado\n//   p.inicio       início da extrusão na normal do plano; p.profundidade = comprimento\n// Referencial: X = u e Y = v do eixo de trabalho, Z = normal dele (a extrusão).\nconst faixas = p.faixas || [[[0, 0], [3, 1.2], [6, 0], [6, -0.15], [3, 1.05], [0, -0.15]]];\nconst camadas = (p.camadas || []).length ? p.camadas : [{ nome: 'Genérico', material: null, espessura: 0.15 }];\nconst prof = p.profundidade || p.comprimento;\nfaixas.forEach((f, i) => {\n  if (!f) return;\n  const c = camadas[i] || camadas[camadas.length - 1];\n  g.extrude(f, prof, { z: p.inicio || 0, material: c.material, name: c.nome, layer: i });\n});\n"
}