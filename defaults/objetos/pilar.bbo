{
  "format": "boxbim-objeto",
  "version": 1,
  "revision": 1,
  "author": "BoxBim",
  "created": "2026-10-22",
  "id": "pilar",
  "name": "Pilar",
  "category": "IfcColumn",
  "sistema": "pilar",
  "description": "Pilar criado pela ferramenta Pilar. Núcleo retangular ou circular; as demais camadas do tipo revestem em volta.",
  "parameters": [
    {
      "name": "largura",
      "label": "Largura (X) / diâmetro",
      "type": "comprimento",
      "default": 0.3,
      "group": "Seção",
      "min": 0.05,
      "max": 5
    },
    {
      "name": "profundidade",
      "label": "Profundidade (Y)",
      "type": "comprimento",
      "default": 0.3,
      "group": "Seção",
      "min": 0.05,
      "max": 5
    },
    {
      "name": "altura",
      "label": "Altura",
      "type": "comprimento",
      "default": 3,
      "group": "Seção",
      "min": 0.1,
      "max": 100
    },
    {
      "name": "circular",
      "label": "Circular",
      "type": "booleano",
      "default": false,
      "group": "Seção"
    }
  ],
  "script": "// Objeto de SISTEMA: usado pelas ferramentas da faixa (Modelar). O BoxBim preenche, em cada elemento do modelo:\n//   p.camadas  [{ nome, material, espessura, funcao }] do tipo do pilar: a 1ª é o núcleo, as outras revestem\n// Referencial: origem no centro da base do pilar, Z para cima.\nconst camadas = (p.camadas || []).length ? p.camadas : [{ nome: 'Genérico', material: null, espessura: 0 }];\nconst L = p.largura, P = p.profundidade, H = p.altura;\n\n// contorno da seção crescido de \"d\" em volta\nconst contorno = d => p.circular\n  ? Array.from({ length: 40 }, (_, k) => [(L / 2 + d) * Math.cos(k / 40 * 2 * Math.PI), (L / 2 + d) * Math.sin(k / 40 * 2 * Math.PI)])\n  : [[-L / 2 - d, -P / 2 - d], [L / 2 + d, -P / 2 - d], [L / 2 + d, P / 2 + d], [-L / 2 - d, P / 2 + d]];\n\nlet d = 0;\ncamadas.forEach((c, i) => {\n  if (i === 0) { g.extrude(contorno(0), H, { material: c.material, name: c.nome, layer: 0 }); return; }\n  if (c.espessura <= 0) return;\n  const dentro = contorno(d);\n  d += c.espessura;\n  g.extrude(contorno(d), H, { holes: [dentro], material: c.material, name: c.nome, layer: i });\n});\n"
}